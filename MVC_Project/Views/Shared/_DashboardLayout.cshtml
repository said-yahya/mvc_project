
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Weather Dashboard</title>
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet" 
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
        crossorigin="anonymous">
    <link href="/dashboard-assets/css/argon-dashboard.css" rel="stylesheet" />

    <style>
        /* Fixed Navbar */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 100px;
            padding: 0 2rem;
            background-color: #2919d4;
            /* Add this to ensure proper centering */
            min-height: 100px;
        }
        
        /* Ensure the flex containers inside navbar are properly centered */
        .navbar > div {
            display: flex;
            align-items: center;
            height: 100%;
        }
        
        /* Force color for username text */
        .navbar .user-name { 
            color: #ffffff; 
        }
        
        .navbar .btn {
            padding: 8px 16px;
            line-height: 1.5;
        }
 
        .navbar .btn img {
            align-items: center;
            display: block; 
            width: 20px;
            height: 20px;
        }
        
        .navbar a {
            color: white;
            margin-left: 1rem;
            text-decoration: none;
        }

        .navbar form {
            display: flex;
            align-items: center;
            height: 100%;
            margin: 0;
        }

        /* Rest of your styles remain the same */
        .sidebar {
            width: 200px;
            min-height: calc(100vh - 100px);
            background-color: #dce9f5;
            color: #150101;
            padding: 1rem;
        }

        .sidebar.offcanvas {
            width: 200px;
        } 

        .main {
            padding: 2rem;
            background-color: #f6f8f8;
            border-radius: 8px;
            margin: 1rem;
        }

        .layout {
            display: flex;
        }

        .container {
            gap: 1rem;
            padding: 1rem;
        }

        .box {
            flex: 1;
            padding: 2rem;
            background-color: #ecf0f1;
            text-align: center;
            border-radius: 8px;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
        }

        .table th {
            text-align: center;
        }

        /* Make the navbar row center its children vertically */
        #navbarBlur .container-fluid { display: flex; align-items: center; }

        /* Ensure left group also centers its items */
        #navbarBlur .container-fluid > .d-flex { align-items: center; }

        /* Normalize heading/button vertical alignment */
        #navbarBlur h6 { margin: 0; line-height: 1; }

        /* Make buttons vertically centered with consistent height */
        #navbarBlur .btn { display: inline-flex; align-items: center; height: 40px; padding: 0 .75rem; }

        /* Prevent image icon adding extra baseline space */
        #navbarBlur .btn img { display: block; }
    </style>
</head>
<body>
  <div class="navbar">
    <div class="d-flex align-items-center">
        <button class="btn border border-white me-3 d-lg-none d-flex align-items-center" data-bs-toggle="offcanvas" data-bs-target="#sidebar">
            <img src="~/images/menu.svg" alt="menu" width="20" height="20">
        </button>
        <h6 class="font-weight-bolder mb-0 text-white">@ViewData["Title"]</h6>
    </div>
    <div class="ms-auto d-flex align-items-center gap-3">
        @if (User?.Identity?.IsAuthenticated == true)
		{
        <span class="d-none d-md-inline-block user-name">@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value @User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value</span>
        <form asp-controller="Login" asp-action="Logout" method="post" class="m-0 d-flex align-items-center">
            <button type="submit" class="btn d-inline-flex align-items-center ms-3 d-none d-sm-inline-block" style="background-color:#941625;color:#fff;">Log out</button>
        </form>
        }  
    </div>
  </div>
  <div >

  </div>
  <div class="layout">
    <!-- Sidebar -->
    <div class="sidebar d-none d-lg-block">
      <ul class="navbar-nav">
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"?"active":"")" asp-controller="Home" asp-action="Index">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-tv-2 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Dashboard</span>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="AllUsers"?"active":"")" asp-controller="Users" asp-action="AllUsers">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-calendar-grid-58 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">All Users</span>
				</a>
			</li>
            <li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Edit"?"active":"")" asp-controller="Users" asp-action="Edit">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-settings text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Edit Users</span>
                </a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="AddUser"?"active":"")" asp-controller="Users" asp-action="AddUser">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-collection text-dark text-sm opacity-10"></i>
                    </div>
			    	<span class="nav-link-text ms-1">Add User</span>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="DeleteUser"?"active":"")" asp-controller="Users" asp-action="DeleteUser">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-single-copy-04 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Delete User</span>
				</a>
			</li>
		</ul>
    </div>
    <!-- Sidebar on middle and small screens -->
    <div class="sidebar offcanvas offcanvas-start d-block d-lg-none" id="sidebar">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        <ul class="navbar-nav">
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"?"active":"")" asp-controller="Home" asp-action="Index">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-tv-2 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Dashboard</span>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="AllUsers"?"active":"")" asp-controller="Users" asp-action="AllUsers">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-calendar-grid-58 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">All Users</span>
				</a>
			</li>
            <li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="Edit"?"active":"")" asp-controller="Users" asp-action="Edit">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-settings text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Edit Users</span>
                </a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="AddUser"?"active":"")" asp-controller="Users" asp-action="AddUser">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-collection text-dark text-sm opacity-10"></i>
                    </div>
			    	<span class="nav-link-text ms-1">Add User</span>
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()=="DeleteUser"?"active":"")" asp-controller="Users" asp-action="DeleteUser">
					<div class="icon icon-shape icon-sm border-radius-md text-center me-2 d-flex align-items-center justify-content-center">
						<i class="ni ni-single-copy-04 text-dark text-sm opacity-10"></i>
					</div>
					<span class="nav-link-text ms-1">Delete User</span>
				</a>
			</li>
		</ul>
    </div>
    @RenderBody()
    
  </div>
  <script 
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
    crossorigin="anonymous">
  </script>
  <script src="/dashboard-assets/js/plugins/chartjs.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
  <script>
document.addEventListener('DOMContentLoaded', () => {
  const defaultCity = 'Istanbul'; // or any city you prefer
  const cityInput = document.getElementById('citySearch');
  if (cityInput && !cityInput.value.trim()) {
    cityInput.value = defaultCity;
  }
  // kick initial load
  const city = (cityInput?.value || defaultCity).trim();
  if (city) {
    loadWeatherData(city);
  }
});
</script>
</body>
</html>
